<% 
  score = sentiment.score.to_f 
  
  if score >= 75
    color = "bg-emerald-500"
    text_color = "text-emerald-400"
    label = "Strong Buy"
    reason = "🚀 ตรวจพบแรงซื้อวาฬ (Whale) และ Volume พุ่งสูง!"
    tooltip = "AI Analysis: Bullish Divergence detected combined with High Volume inflow."
  elsif score >= 60
    color = "bg-teal-500"
    text_color = "text-teal-400"
    label = "Buy"
    reason = "📈 เทรนด์ขาขึ้นชัดเจน EMA ตัดขึ้น"
    tooltip = "AI Analysis: Price action shows positive momentum above moving averages."
  elsif score <= 25
    color = "bg-rose-600"
    text_color = "text-rose-500"
    label = "Strong Sell"
    reason = "🚨 เกิดสัญญาณ Overbought รุนแรง ระวังทุบ!"
    tooltip = "AI Analysis: Extreme RSI levels indicating a potential sharp correction."
  elsif score <= 40
    color = "bg-rose-500"
    text_color = "text-rose-400"
    label = "Sell"
    reason = "📉 หลุดแนวรับสำคัญ แรงขายเริ่มมา"
    tooltip = "AI Analysis: Support levels broken with increasing sell volume."
  else 
    color = "bg-amber-500"
    text_color = "text-amber-400"
    label = "Hold"
    reason = "👀 ตลาดไซด์เวย์ รอเลือกทางที่ชัดเจน"
    tooltip = "AI Analysis: Low volatility detected. Market is currently deciding direction."
  end
%>

<div id="sentiment_<%= sentiment.coin_symbol %>" 
     onclick="loadChart('<%= sentiment.coin_symbol %>')"
     title="<%= tooltip %>"
     class="bg-[#131b2e] rounded-xl p-5 border border-slate-700 hover:border-cyan-500/50 transition-all shadow-md group relative overflow-hidden cursor-help">
  
  <div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-br from-white/5 to-transparent rounded-bl-full pointer-events-none"></div>

  <div class="flex justify-between items-start mb-3">
    <div class="flex items-center gap-3">
      <img src="https://cdn.jsdelivr.net/gh/atomiclabs/cryptocurrency-icons@1a63530be6e374711a8554f31b17e4cb92c25fa5/128/color/<%= sentiment.coin_symbol.downcase %>.png" 
           onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Anonymous_emblem.svg/1200px-Anonymous_emblem.svg.png'"
           class="w-10 h-10 rounded-full shadow-lg" alt="<%= sentiment.coin_symbol %>">
      <div>
        <h3 class="font-bold text-white text-base tracking-wide"><%= sentiment.coin_symbol %></h3>
        <span class="text-[10px] text-slate-400 border border-slate-700 px-1 rounded">PERP</span>
      </div>
    </div>
    
    <div class="text-right">
       <div class="text-lg font-bold text-white tracking-tight">
         ฿<%= number_with_precision(sentiment.price * 34.5, precision: 0, delimiter: ',') %>
       </div>
       <div class="text-[10px] text-slate-500 font-mono">
         $<%= number_with_precision(sentiment.price, precision: 2, delimiter: ',') %>
       </div>
    </div>
  </div>

  <div class="bg-slate-900/50 rounded-lg p-2.5 border border-slate-800">
    <div class="flex justify-between items-center mb-1.5">
      <span class="text-[10px] font-bold <%= text_color %> uppercase tracking-wider"><%= label %></span>
      <span class="text-[10px] text-slate-500 font-mono"><%= score.round(0) %>/100</span>
    </div>
    
    <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden mb-2">
      <div class="h-full <%= color %> transition-all duration-500 shadow-[0_0_10px_currentColor]" style="width: <%= score %>%"></div>
    </div>
    
    <div class="flex gap-1.5 items-start">
       <svg class="w-3 h-3 text-slate-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
       <p class="text-[10px] text-slate-400 leading-tight"><%= reason %></p>
    </div>
  </div>
  
  <template>
    <script>
       // อัปเดตราคาใน Dropdown ของ Calculator แบบเงียบๆ
       var opt = document.querySelector("#coin_select option[value='<%= sentiment.coin_symbol %>']");
       if(opt) { opt.setAttribute("data-price", "<%= sentiment.price %>"); }
    </script>
  </template>
</div>