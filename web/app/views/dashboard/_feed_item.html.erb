<tr id="row_<%= sentiment.coin_symbol %>" 
    onclick="loadChart('<%= sentiment.coin_symbol %>')"
    class="coin-row hover:bg-slate-800 transition-colors group cursor-pointer border-l-2 border-transparent hover:border-cyan-500 relative"
    data-symbol="<%= sentiment.coin_symbol %>"
    data-usd-price="<%= sentiment.price %>">
   
   <td class="px-3 py-3 text-slate-600 font-mono text-[10px]">
      <% if sentiment.coin_symbol == 'BTC' %>
        <span class="text-yellow-500" title="King">👑</span>
      <% elsif sentiment.coin_symbol == 'ETH' %>
        <span class="text-slate-400" title="Queen">🥈</span>
      <% else %>
        <span class="opacity-30">#</span>
      <% end %>
   </td>

   <td class="px-3 py-3">
      <div class="flex items-center gap-2">
         <img src="https://cdn.jsdelivr.net/gh/atomiclabs/cryptocurrency-icons@1a63530be6e374711a8554f31b17e4cb92c25fa5/128/color/<%= sentiment.coin_symbol.downcase %>.png" 
              onerror="this.onerror=null; this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Anonymous_emblem.svg/120px-Anonymous_emblem.svg.png'"
              class="w-5 h-5 rounded-full shadow-sm" alt="<%= sentiment.coin_symbol %>">
         <div>
            <div class="font-bold text-slate-200 text-xs"><%= sentiment.coin_symbol %></div>
         </div>
      </div>
   </td>

   <td class="px-3 py-3 text-right">
      <div class="font-mono font-medium text-xs whitespace-nowrap text-slate-200">
         <span class="dynamic-thb-price" data-original-usd="<%= sentiment.price %>">
            ฿<%= number_with_precision(sentiment.price * 34.5, precision: 2, delimiter: ',') %>
         </span>
      </div>
   </td>

   <td class="px-3 py-3 text-right">
      <% 
         change = sentiment.respond_to?(:change_24h) ? sentiment.change_24h.to_f : 0.0 
         has_data = sentiment.respond_to?(:change_24h) && sentiment.change_24h.present?
         is_positive = change >= 0
      %>
      <% if has_data %>
         <div class="flex items-center justify-end gap-1 <%= is_positive ? 'text-emerald-400' : 'text-rose-400' %>">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= is_positive ? 'M5 10l7-7m0 0l7 7m-7-7v18' : 'M19 14l-7 7m0 0l-7-7m7 7V3' %>" />
            </svg>
            <span class="font-bold text-xs"><%= change.abs.round(2) %>%</span>
         </div>
      <% else %>
         <span class="text-slate-600 text-[10px]">...</span>
      <% end %>
   </td>

   <td class="px-3 py-3 text-center">
      <% 
         score = sentiment.score.to_f 
         if score >= 75
            style_class = "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
         elsif score >= 60
            style_class = "bg-cyan-500/10 text-cyan-400 border-cyan-500/20"
         elsif score <= 40
            style_class = "bg-rose-500/10 text-rose-400 border-rose-500/20"
         else
            style_class = "bg-amber-500/10 text-amber-400 border-amber-500/20"
         end
      %>
      <span class="text-[10px] font-bold font-mono px-2 py-0.5 rounded border <%= style_class %>">
         <%= score.round(0) %>
      </span>
   </td>

</tr>